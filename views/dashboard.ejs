
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Expense Tracker Dashboard</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: Arial, sans-serif;
            background: #f4f6f9;
            color: #333;
        }

        .container {
            width: 90%;
            max-width: 1200px;
            margin: 40px auto;
        }

        h1 {
            margin-bottom: 30px;
        }

        .cards {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin-bottom: 40px;
        }

        .card {
            background: white;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0 3px 10px rgba(0, 0, 0, 0.1);
        }

        .card h3 {
            color: #777;
            margin-bottom: 10px;
        }

        .card p {
            font-size: 28px;
            font-weight: bold;
        }

        .income {
            color: green;
        }

        .expense {
            color: red;
        }

        .balance {
            color: #007bff;
        }

        .transactions {
            color: #333;
        }

        .section {
            background: white;
            padding: 25px;
            border-radius: 10px;
            margin-bottom: 30px;
            box-shadow: 0 3px 10px rgba(0, 0, 0, 0.1);
        }

        .section h2 {
            margin-bottom: 20px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        table th,
        table td {
            padding: 15px;
            border-bottom: 1px solid #ddd;
            text-align: left;
        }

        table th {
            background: #f1f1f1;
        }

        .count-box {
            display: flex;
            gap: 30px;
            margin-top: 20px;
        }

        .count {
            background: #f5f5f5;
            padding: 15px 25px;
            border-radius: 8px;
        }

        @media (max-width: 800px) {
            .cards {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 500px) {
            .cards {
                grid-template-columns: 1fr;
            }

            .count-box {
                flex-direction: column;
                gap: 10px;
            }
        }
    </style>
</head>

<body>

    <div class="container">
        <h1>Expense Tracker Dashboard</h1>

    
        <!-- SUMMARY CARDS -->
   

        <div class="cards">
            <div class="card">
                <h3>Total Income</h3>
                <p class="income">
                    Rs. <%= dashboard.totalIncome %>
                </p>
            </div>


            <div class="card">
                <h3>Total Expense</h3>
                <p class="expense">
                    Rs. <%= dashboard.totalExpense %>
                </p>
            </div>


            <div class="card">
                <h3>Balance</h3>
                <p class="balance">
                    Rs. <%= dashboard.balance %>
                </p>
            </div>


            <div class="card">
                <h3>Total Transactions</h3>
                <p class="transactions">
                    <%= dashboard.totalTransactions %>
                </p>
            </div>

        </div>
     
        <!-- TRANSACTION COUNTS -->     

        <div class="section">
            <h2>Transaction Statistics</h2>
            <div class="count-box">
                <div class="count">
                    <strong>Income Transactions:</strong>
                    <%= dashboard.incomeCount %>
                </div>

                <div class="count">
                    <strong>Expense Transactions:</strong>
                    <%= dashboard.expenseCount %>
                </div>
            </div>
        </div>


        <!-- CATEGORY SUMMARY -->
 

        <div class="section">
            <h2>Expense By Category</h2>


            <% if (categories.length === 0) { %>

                <p>No expense data available.</p>

            <% } else { %>

                <table>
                    <thead>
                        <tr>
                            <th>Category</th>
                            <th>Total Expense</th>
                        </tr>

                    </thead>

                    <tbody>

                        <% categories.forEach(category => { %>

                            <tr>
                                <td>
                                    <%= category._id %>
                                </td>

                                <td>
                                    Rs. <%= category.total %>
                                </td>

                            </tr>

                        <% }) %>

                    </tbody>
                </table>
            <% } %>
        </div>
    </div>
</body>

</html>

